# Copy to .env (or .env.<NODE_ENV>, which wins) and fill in. Never commit real values.

# --- Application -------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Comma-separated origins allowed by CORS. Empty: any origin in development, none otherwise.
CORS_ORIGINS=
# Swagger UI at /api. Default: on unless NODE_ENV=production.
SWAGGER_ENABLED=
# Time zone that defines "today" for indicators and the daily report.
APP_TIMEZONE=America/Bogota

# --- Database (PostgreSQL) ---------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zoo
DB_USERNAME=
DB_PASSWORD=
# Apply pending migrations on start (default true). Set false to run them with npm run db:migrate.
DB_MIGRATE=true
# Create DB_NAME if it does not exist (default: on unless NODE_ENV=production).
DB_CREATE_IF_MISSING=

# --- Authentication ------------------------------------------------------------
# At least 32 random characters.
JWT_KEY=
JWT_EXPIRES_IN=24h
# Seeds admin@mail.com with ADMIN_PASSWORD on start (default: only in development).
SEED_ADMIN=
ADMIN_PASSWORD=

# --- Demo data (npm run db:seed) ----------------------------------------------
DEMO_USER_PASSWORD=
SEEDER_ADDITIONAL_USERS=5
SEEDER_ZONES_COUNT=3
SEEDER_SPECIES_PER_ZONE=5
SEEDER_ANIMALS_PER_SPECIES=5
SEEDER_COMMENTS_PER_ANIMAL=3

# --- Daily report (Excel + PDF to R2, e-mail through api-mail via RabbitMQ) ----
# Default: on, except NODE_ENV=test.
REPORTS_ENABLED=
# Seconds field included. Default: every day at 23:55 APP_TIMEZONE.
REPORTS_CRON=0 55 23 * * *
REPORT_FONTS_DIR=
RABBITMQ_URL=amqp://localhost
QUEUE_NAME=email_queue
RABBITMQ_PUBLISH_RETRIES=5
RABBITMQ_RETRY_DELAY_MS=1000
R2_ACCOUNT_ID=
R2_BUCKET_ACCESS_KEY=
R2_BUCKET_SECRET_KEY=
R2_BUCKET_NAME=
R2_BUCKET_REGION=auto

# --- e2e tests (npm run test:e2e). The database is emptied by the tests! -------
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=
TEST_DB_USERNAME=
TEST_DB_PASSWORD=
